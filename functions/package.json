{
  "name": "livingshare-functions",
  "version": "1.0.0",
  "description": "Cloud Functions para LivingShare",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "lint": "eslint --ext .ts src/",
    "test": "jest"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "13.4.0",
    "firebase-functions": "6.3.2",
    "stripe": "17.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/stripe": "^8.0.417",
    "firebase-functions-test": "^3.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.13",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "strict": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^firebase-admin$": "<rootDir>/src/__mocks__/firebase-admin.ts",
      "^firebase-admin/(.*)$": "<rootDir>/src/__mocks__/firebase-admin.ts",
      "^firebase-functions/v2/https$": "<rootDir>/src/__mocks__/firebase-functions.ts",
      "^firebase-functions/params$": "<rootDir>/src/__mocks__/firebase-functions-params.ts",
      "^firebase-functions$": "<rootDir>/src/__mocks__/firebase-functions.ts",
      "^stripe$": "<rootDir>/src/__mocks__/stripe.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ]
  },
  "private": true
}
